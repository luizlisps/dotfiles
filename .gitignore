*
!.gitignore
!install.sh

# Shell and terminal
!.zprofile
!.zshenv
!.zshrc
!.tmux.conf
!.local/
!.local/bin/
!.local/bin/tmux-git-status

# Application configuration
!.config/
.config/*
!.config/ghostty/
!.config/ghostty/config
!.config/ghostty/themes/
!.config/ghostty/themes/**
!.config/nvim/
!.config/nvim/**
!.config/starship.toml
!.config/lazygit/
!.config/lazygit/config.yml
!.config/fastfetch/
!.config/fastfetch/**
!.config/opencode/
!.config/opencode/**
!.config/yazi/
!.config/yazi/**

# Oh My Pi custom themes
!.omp/
!.omp/agent/
!.omp/agent/themes/
!.omp/agent/themes/**

# Hermes Agent non-secret configuration
!.hermes/
.hermes/*
!.hermes/config.yaml
!.hermes/skins/
!.hermes/skins/**

# Claude Code settings and personal skills; synced skills are managed by claude.ai
!.claude/
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
.claude/skills/synced/

# Generated files inside tracked trees
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
