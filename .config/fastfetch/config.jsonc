{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "debian",
        "padding": {
            "right": 4
        },
        "color": {
            "1": "38;2;220;50;47",
            "2": "38;2;181;137;0",
            "3": "38;2;220;50;47",
            "4": "38;2;211;54;130",
            "5": "38;2;38;139;210"
        }
    },
    "display": {
        "separator": " ->     ",
        "color": {
            "keys": "38;2;181;137;0",
            "title": "38;2;101;123;131",
            "output": "38;2;101;123;131",
            "separator": "38;2;101;123;131"
        },
        "key": {
            "width": 17
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name} @ {host-name}"
        },
        {
            "type": "os",
            "key": "os      ",
            "format": "{name} {codename}"
        },
        {
            "type": "shell",
            "key": "shell   ",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "terminal",
            "format": "{pretty-name}"
        },
        {
            "type": "battery",
            "key": "battery ",
            "format": "{capacity}",
            "outputColor": "38;2;133;153;0"
        },
        {
            "type": "cpu",
            "key": "cpu     ",
            "format": "{name}"
        },
        {
            "type": "uptime",
            "key": "uptime  "
        }
    ]
}
